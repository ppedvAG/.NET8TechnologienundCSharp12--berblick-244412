<Window x:Class="DelegateWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DelegateWPF"
        mc:Ignorable="d"
		WindowStartupLocation="CenterScreen"
        Title="MainWindow" Height="450" Width="200"
		Name="Self"
		MouseEnter="Self_MouseEnter"
		MouseLeave="Self_MouseLeave">
	<StackPanel>
		<!--Click-Event-->
		<!--Wird ausgeführt, wenn der User auf den Button klickt-->
		
		<!--Entwicklerseite:-->
		<!--public event EventHandler<RoutedEventArgs> Click;-->
		<!--... Click(this, e); ...-->
		
		<!--Anwenderseite:-->
		<!--((System.Windows.Controls.Button)(target)).Click += new System.Windows.RoutedEventHandler(this.Button_Click);-->
		
		<!--Wann wird das Click-Event ausgeführt?-->
		<!--1. Wenn die Maus auf dem Button ist-->
		<!--2. Wenn der User die linke Maustaste verwendet-->
		<!--3. Wenn keine anderen UI Elemente im Weg sind-->
		<!--4. ...-->
		<Button Click="Button_Click"
				Content="Hallo Welt"/>
	</StackPanel>
</Window>
